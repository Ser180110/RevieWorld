# Copia questo file in .env.local e riempi i valori dal pannello Supabase.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase > Connect > ORMs (Drizzle)
# Connessione "Transaction pooler" (porta 6543), usata dall'app
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Connessione diretta o "Session pooler" (porta 5432), usata per le migrazioni
DIRECT_DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
