# Copia questo file in .env.local e riempi i valori dal pannello Supabase.

# Supabase > Connect > Framework (Next.js)
# La chiave può chiamarsi anche NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: funzionano entrambi i nomi.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase > Connect > ORM (Drizzle). Sostituisci [YOUR-PASSWORD] con la password del database.
# Connessione "Transaction pooler" (porta 6543), usata dall'app
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Connessione diretta o "Session pooler" (porta 5432), usata per le migrazioni
DIRECT_DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Indirizzo pubblico dell'app, usato nei link delle email di conferma.
# In locale: http://localhost:3000 ; su Vercel: il tuo dominio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Facoltativo: sticker e GIF da GIPHY (chiave gratuita su developers.giphy.com).
GIPHY_API_KEY=

# Facoltativo: notifiche push sul telefono. Genera la coppia con
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
